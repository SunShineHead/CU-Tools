# ====================================================================
# Custom Analyzer with Allow Replace Flag (Production-Ready)
# ====================================================================
#
# Purpose:
# Create or replace a custom Content Understanding analyzer safely
# using allowReplace=true for CI/CD and schema evolution.
#
# API Reference:
# https://learn.microsoft.com/en-us/rest/api/contentunderstanding/content-analyzers/create-or-replace
#
# ====================================================================

# -----------------------------
# Environment Variables (.env)
# -----------------------------
@subscriptionKey = {{$dotenv API_KEY}}
@endpoint        = {{$dotenv ENDPOINT_URL}}
@apiVersion      = 2025-11-01

# ====================================================================
# 1. Create or Replace Custom Analyzer (Idempotent)
# ====================================================================

# @name createOrReplaceClaimsAnalyzer
PUT {{endpoint}}/contentunderstanding/analyzers/custom_claims_analyzer
    ?api-version={{apiVersion}}
    &allowReplace=true
Ocp-Apim-Subscription-Key: {{subscriptionKey}}
Content-Type: application/json

{
  "displayName": "Insurance Claims Analyzer",
  "description": "Production analyzer for structured insurance claims extraction",
  "tags": {
    "version": "2.0",
    "category": "claims",
    "owner": "claims-platform-team",
    "environment": "prod"
  },

  "baseAnalyzerId": "prebuilt-document",

  "models": {
    "completion": {
      "modelName": "gpt-4.1",
      "temperature": 0.2,
      "maxTokens": 1024
    },
    "embedding": {
      "modelName": "text-embedding-3-large"
    }
  },

  "fieldSchema": {
    "name": "Insurance Claims Schema v2",
    "description": "Extract, classify, and generate insights from insurance claims",

    "fields": {
      "ClaimNumber": {
        "type": "string",
        "method": "extract",
        "description": "Unique claim reference number"
      },

      "ClaimDate": {
        "type": "date",
        "method": "extract",
        "description": "Date the claim was filed"
      },

      "PolicyHolder": {
        "type": "string",
        "method": "extract",
        "description": "Full name of the policy holder"
      },

      "PolicyNumber": {
        "type": "string",
        "method": "extract",
        "description": "Insurance policy number"
      },

      "LossType": {
        "type": "string",
        "method": "classify",
        "enum": ["property", "auto", "health", "liability", "other"],
        "description": "Category of insured loss"
      },

      "ClaimAmount": {
        "type": "number",
        "method": "extract",
        "description": "Total amount claimed",
        "unit": "currency"
      },

      "Currency": {
        "type": "string",
        "method": "extract",
        "description": "ISO 4217 currency code (e.g. SGD, USD)"
      },

      "ClaimStatus": {
        "type": "string",
        "method": "classify",
        "enum": ["pending", "approved", "denied", "settled"],
        "description": "Current claim status"
      },

      "AdjusterName": {
        "type": "string",
        "method": "extract",
        "description": "Assigned claims adjuster"
      },

      "ClaimSummary": {
        "type": "string",
        "method": "generate",
        "description": "Concise AI-generated claim summary"
      },

      "RiskAssessment": {
        "type": "string",
        "method": "generate",
        "description": "AI-generated risk and fraud assessment"
      },

      "DocumentedExpenses": {
        "type": "array",
        "method": "extract",
        "description": "Itemized documented expenses",
        "items": {
          "type": "object",
          "required": ["Date", "Amount"],
          "properties": {
            "Date": {
              "type": "date",
              "description": "Expense date"
            },
            "Category": {
              "type": "string",
              "description": "Expense category"
            },
            "Amount": {
              "type": "number",
              "description": "Expense amount"
            },
            "Description": {
              "type": "string",
              "description": "Expense description"
            },
            "Verified": {
              "type": "boolean",
              "description": "Whether expense was verified"
            }
          }
        }
      }
    },

    "definitions": {}
  },

  "config": {
    "enableOcr": true,
    "enableLayout": true,
    "enableFormula": false,

    "returnDetails": true,
    "omitContent": false,

    "estimateFieldSourceAndConfidence": true,
    "languageHint": "en"
  }
}
